PROJECT_NAME="AI E-Learning Recommendation System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="elearning_recsys"

# SQLAlchemy URLs
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning_recsys"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/elearning_recsys"

# Secondary Storage
REDIS_URL="redis://localhost:6379/0"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# Security
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGE_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
